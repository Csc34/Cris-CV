{
  "name": "portfolio",
  "private": true,
  "workspaces": [
    "apps/web",
    "infra"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "vite": "^6.4.3",
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web && npm run typecheck --workspace infra",
    "test": "npm run test --workspace apps/web && npm run test --workspace infra",
    "test:e2e": "npm run test:e2e --workspace apps/web"
  }
}
